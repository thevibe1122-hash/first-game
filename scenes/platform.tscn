[ext_resource type="Texture2D" uid="uid://cphw2isno1rl8" path="res://assets/brackeys_platformer_assets/sprites/0x72_DungeonTilesetII_v1.7.png" id="1_mi635"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_mq8aq"]
size = Vector2(47.627907, 14.564127)

[sub_resource type="GDScript" id="GDScript_mq8aq"]
script/source = "extends Area2D

@export var platform_collision: CollisionShape2D
@export var platform_sprite: Sprite2D

@onready var timer: Timer = $Timer
@onready var timer_2: Timer = $Timer2

func _ready() -> void:
	# Ensure it starts solid and visible
	if platform_collision:
		platform_collision.disabled = false
	if platform_sprite:
		platform_sprite.show()

func _on_body_entered(_body: Node2D) -> void:
	print(\"Player touched Area2D! Starting Timer 1.\")
	timer.start()

func _on_timer_timeout() -> void:
	print(\"Timer 1 Done: Hiding Platform.\")
	if platform_collision:
		platform_collision.set_deferred(\"disabled\", true)
	if platform_sprite:
		platform_sprite.hide()
	
	timer_2.start()

func _on_timer_2_timeout() -> void:
	print(\"Timer 2 Done: Showing Platform.\")
	if platform_collision:
		platform_collision.set_deferred(\"disabled\", false)
	if platform_sprite:
		platform_sprite.show()
"

